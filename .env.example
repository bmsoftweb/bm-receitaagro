# Porta do ReceitaWeb (os projetos dividem a 3000 em desenvolvimento)
RECEITA_PORT=3000

# ------------------------------------------------------------
# Servidores da bmAPI (D:\bmsoft\BMapi)
# No login o usuário digita o número do servidor; URL, porta e token (X-API-Key)
# vêm da tabela servidores deste MySQL. O token nunca chega ao navegador.
# A base do servidor precisa estar com allowWrite=true no config.ini da bmAPI.
# ------------------------------------------------------------
MYSQL_HOST=45.224.130.145
MYSQL_PORT=3306
MYSQL_USER=bmsoftadm
MYSQL_PASSWORD=
MYSQL_DATABASE=bmapi
# Compêndio próprio a partir das bulas (scripts/compendio_mysql.sql)
MYSQL_DATABASE_COMPENDIO=receitaweb
# Números (servidores.numero) cujos administradores conferem as bulas, separados por vírgula
COMPENDIO_SERVIDORES=

# ------------------------------------------------------------
# Carga do compêndio pelas bulas (script de carga; não é usado pelo app na Vercel)
# ------------------------------------------------------------
# AgroAPI da Embrapa (API AGROFIT): consumer key e secret da aplicação
AGROAPI_CONSUMER_KEY=
AGROAPI_CONSUMER_SECRET=
# API da Claude: leitura das bulas
ANTHROPIC_API_KEY=
# Modelo da 1ª leitura das bulas (padrão claude-haiku-5-5); as incompletas são refeitas com o claude-opus-5-5
MODELO_COMPENDIO=

# Segredo usado para assinar o token de sessão (qualquer texto longo e aleatório)
SESSION_SECRET=

# ------------------------------------------------------------
# Regras de negócio
# ------------------------------------------------------------
# Empresa (EMPRESAS.ID): profissionais, ARTs, receitas e estoque
ID_EMPRESA=1

# S = só imprime receita já transmitida à CIDASC (número CIDASC gravado pelo receita_e.exe)
EXIGE_CIDASC_IMPRESSAO=S
